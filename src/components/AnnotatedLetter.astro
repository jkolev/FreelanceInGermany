---
/**
 * A real (anonymized!) letter with numbered notes explaining each part.
 * Remove names, addresses, tax numbers and reference numbers before adding the scan.
 *
 * import letter from '../../../assets/letters/vorauszahlung.png';
 * <AnnotatedLetter
 *   src={letter}
 *   alt="Tax prepayment notice from the tax office"
 *   title="A tax prepayment notice (Vorauszahlungsbescheid)"
 *   notes={[
 *     { x: 72, y: 12, label: 'Steuernummer', text: 'Your tax number. Put it on every invoice.' },
 *     { x: 30, y: 58, label: 'Fälligkeit', text: 'The dates your prepayments are due.' },
 *   ]}
 * />
 * x and y are the marker's position in percent of the image's width and height.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Note {
  x: number;
  y: number;
  /** German words on the letter this note explains */
  label?: string;
  text: string;
}
interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  notes: Note[];
}
const { src, alt, title, notes } = Astro.props;
const w = src.width;
const h = src.height;
const r = Math.round(w * 0.022);
---
<figure class="not-prose card my-8 overflow-hidden">
  {title && <figcaption class="border-b border-line px-5 py-3.5 font-semibold">{title}</figcaption>}
  <div class="flex flex-col md:flex-row">
    <div class="relative bg-subtle p-4 md:w-3/5">
      <div class="relative">
        <Image src={src} alt={alt} widths={[480, 960]} sizes="(min-width: 768px) 430px, 100vw" class="block h-auto w-full rounded-md border border-line shadow-sm" />
        <svg viewBox={`0 0 ${w} ${h}`} class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
          {
            notes.map((n, i) => (
              <g>
                <circle cx={(n.x / 100) * w} cy={(n.y / 100) * h} r={r} class="fill-accent" stroke="#fff" stroke-width={r * 0.18} />
                <text
                  x={(n.x / 100) * w}
                  y={(n.y / 100) * h}
                  dy="0.35em"
                  text-anchor="middle"
                  font-size={r * 1.1}
                  font-weight="700"
                  class="fill-white font-sans"
                >
                  {i + 1}
                </text>
              </g>
            ))
          }
        </svg>
      </div>
    </div>
    <ol class="m-0 flex list-none flex-col gap-4 p-5 md:w-2/5">
      {
        notes.map((n, i) => (
          <li class="flex gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-bold text-on-accent">
              {i + 1}
            </span>
            <div class="text-[15px] leading-relaxed">
              {n.label && (
                <span lang="de" class="block font-semibold italic">
                  {n.label}
                </span>
              )}
              <span class="text-ink-2">{n.text}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</figure>
