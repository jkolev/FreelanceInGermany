---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Avatar from '../components/Avatar.astro';
import { site, getHub } from '../data/site';
import { cleanPath, formatDate, type Article } from '../lib/articles';

interface Props {
  article: Article;
  headings: MarkdownHeading[];
}

const { article, headings } = Astro.props;
const { data } = article;
const hub = getHub(data.hub)!;
const url = new URL(cleanPath(Astro.url.pathname), Astro.site).toString();

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.published.toISOString(),
    dateModified: data.lastChecked.toISOString(),
    author: { '@type': 'Person', name: site.author.name, url: new URL(site.author.url, Astro.site).toString() },
    publisher: { '@type': 'Organization', name: site.name },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: hub.title, item: new URL(`/${hub.id}`, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
if (data.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

const tocExtra = [
  ...(data.faq.length ? [{ slug: 'faq', text: 'Questions' }] : []),
  ...(data.sources.length ? [{ slug: 'sources', text: 'Sources' }] : []),
];
---
<BaseLayout title={data.title} description={data.description} current={hub.id} jsonLd={jsonLd} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={data.published.toISOString()} />
    <meta property="article:modified_time" content={(data.lastChecked > data.published ? data.lastChecked : data.published).toISOString()} />
    <meta property="article:section" content={hub.title} />
  </Fragment>
  <div class="container-page pt-10">
    <Breadcrumb items={[{ href: `/${hub.id}`, label: hub.title }]} />
    <h1 class="m-0 mb-4 max-w-[820px] text-[34px] leading-[1.15] font-bold tracking-[-0.025em] sm:text-[42px]">
      {data.title}
    </h1>
    <div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-[15px] text-muted">
      <span class="flex items-center gap-2.5">
        <Avatar size={32} />
        <span>By <a href={site.author.url} class="font-semibold">{site.author.name}</a></span>
      </span>
      <span aria-hidden="true" class="hidden sm:inline">·</span>
      <span>Last checked <time datetime={data.lastChecked.toISOString().slice(0, 10)}>{formatDate(data.lastChecked)}</time></span>
      {
        data.readingMinutes && (
          <>
            <span aria-hidden="true" class="hidden sm:inline">·</span>
            <span>{data.readingMinutes} min read</span>
          </>
        )
      }
    </div>
    {
      data.hasAffiliateLinks && (
        <p class="m-0 text-sm text-muted">
          Some links on this page are affiliate links.{' '}
          <a href="/how-we-make-money" class="text-muted">
            How we make money
          </a>
        </p>
      )
    }
  </div>

  <div class="container-page flex flex-col gap-6 pt-6 pb-16 lg:flex-row lg:items-start lg:gap-12 lg:pt-8">
    <aside class="hidden w-[220px] shrink-0 self-stretch lg:block">
      <TableOfContents headings={headings} extra={tocExtra} />
    </aside>

    <article class="w-full min-w-0 max-w-[720px] lg:flex-1">
      <details class="card mb-6 px-5 py-3 lg:hidden">
        <summary class="cursor-pointer py-1 text-[15px] font-semibold">On this page</summary>
        <div class="pt-2">
          <TableOfContents headings={headings} extra={tocExtra} compact />
        </div>
      </details>
      <div class="prose prose-lg prose-site max-w-none">
        <slot />
      </div>

      {
        data.faq.length > 0 && (
          <section class="mt-12">
            <h2 id="faq" class="m-0 mb-4 text-[28px] leading-tight font-bold tracking-[-0.02em]">
              Questions
            </h2>
            <div class="flex flex-col gap-3">
              {data.faq.map((f) => (
                <details class="card group px-5 py-4">
                  <summary class="cursor-pointer list-none font-semibold marker:hidden">
                    <span class="flex items-start justify-between gap-4">
                      {f.question}
                      <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">
                        +
                      </span>
                    </span>
                  </summary>
                  <p class="m-0 mt-3 text-base leading-relaxed text-ink-2">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      {
        data.sources.length > 0 && (
          <section class="mt-12">
            <h2 id="sources" class="m-0 mb-3 text-[22px] leading-snug font-bold">
              Sources
            </h2>
            <ul class="m-0 mb-10 list-disc pl-5 text-base text-ink-2">
              {data.sources.map((s) => (
                <li class="mb-1">
                  <a href={s.url} rel="noopener" target="_blank">
                    {s.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <AuthorBox />
    </article>
  </div>
</BaseLayout>
