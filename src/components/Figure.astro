---
/**
 * A diagram or screenshot with a caption.
 * In MDX:  import chart from '../../../assets/vat-flow.png';  <Figure src={chart} alt="…" caption="…" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Screenshots get a border so they don't blend into the page */
  framed?: boolean;
}
const { src, alt, caption, framed = true } = Astro.props;
---
<figure class="not-prose my-8">
  <Image
    src={src}
    alt={alt}
    widths={[400, 720, 1440]}
    sizes="(min-width: 768px) 720px, 100vw"
    class:list={['h-auto w-full rounded-card', framed && 'border border-line']}
  />
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>
