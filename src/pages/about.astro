---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../data/site';
import Avatar from '../components/Avatar.astro';
---
<PageLayout title="About" lead={`Why ${site.name} exists and how articles are checked.`}>
  <div class="not-prose mb-8 flex items-center gap-5">
    <Avatar size={96} />
    <div>
      <p class="m-0 text-xl font-semibold">{site.author.name}</p>
      <p class="m-0 text-muted">[TODO: one line, e.g. “Freelancer in Berlin since 20XX”]</p>
    </div>
  </div>
  <p>[TODO: who you are, and why you built this site. Add your photo as described in src/data/site.ts.]</p>
  <h2>How articles are checked</h2>
  <ul>
    <li>Every figure comes from an official source: the tax office, public insurers, the pension fund or the law itself.</li>
    <li>Every article shows the date it was last checked. Rates and thresholds are reviewed every January.</li>
    <li>This is general information, not advice. For your own situation, talk to a tax advisor or licensed insurance broker.</li>
  </ul>
  <h2>Found a mistake?</h2>
  <p>Please <a href="/contact">tell me</a>. Corrections are fixed quickly and noted in the article.</p>
</PageLayout>
