---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
  extra?: { slug: string; text: string }[];
  /** Collapsed version for phones and tablets */
  compact?: boolean;
}
const { headings, extra = [], compact = false } = Astro.props;
const items = [...headings.filter((h) => h.depth === 2), ...extra];
---
{
  items.length > 0 && (
    <nav aria-label={compact ? 'On this page (menu)' : 'On this page'} class:list={['text-[15px] leading-normal', !compact && 'sticky top-6']}>
      {!compact && <p class="eyebrow mb-3 text-muted">On this page</p>}
      <ol class="m-0 flex list-none flex-col gap-0.5 border-l-2 border-line p-0" data-toc>
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="-ml-0.5 block border-l-2 border-transparent py-2 pl-3.5 text-ink-2 no-underline hover:text-accent data-[active]:border-accent data-[active]:font-semibold data-[active]:text-ink"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
<script>
  // Highlight the section currently in view
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a'));
  const targets = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const setActive = (id: string) =>
      links.forEach((a) => a.toggleAttribute('data-active', a.hash === `#${id}`));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((t) => observer.observe(t));
    setActive(targets[0].id);
  }
</script>
