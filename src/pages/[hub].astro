---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GuideList from '../components/GuideList.astro';
import Icon from '../components/Icon.astro';
import { hubs, type Hub } from '../data/site';
import { getArticles } from '../lib/articles';

export function getStaticPaths() {
  return hubs.map((hub) => ({ params: { hub: hub.id }, props: { hub } }));
}

const { hub } = Astro.props as { hub: Hub };
const articles = await getArticles((a) => a.data.hub === hub.id);
const pillar = articles.find((a) => a.data.type === 'pillar');
const rest = articles.filter((a) => a !== pillar);
---
<BaseLayout title={hub.title} description={`${hub.title} for freelancers in Germany: ${hub.description.toLowerCase()}.`} current={hub.id}>
  <section class="border-b border-line bg-surface">
    <div class="container-page py-12">
      <Breadcrumb items={[]} />
      <div class="flex items-center gap-3 text-accent">
        <Icon name={hub.icon} size={32} />
      </div>
      <h1 class="m-0 mt-3 mb-3 text-[34px] leading-tight font-bold tracking-[-0.025em] sm:text-[42px]">{hub.title}</h1>
      <p class="m-0 max-w-2xl text-xl text-muted">{hub.description}.</p>
      {
        pillar && (
          <a href={`/${pillar.id}`} class="btn-primary mt-8">
            Start with the complete guide
          </a>
        )
      }
    </div>
  </section>
  <section class="container-page py-12">
    <h2 class="m-0 mb-5 text-[26px] leading-tight font-bold tracking-[-0.02em]">All guides</h2>
    <GuideList articles={pillar ? [pillar, ...rest] : rest} />
  </section>
</BaseLayout>
