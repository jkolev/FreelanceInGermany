---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import GuideList from '../components/GuideList.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { site, hubs } from '../data/site';
import { calculators } from '../data/calculators';
import { getArticles } from '../lib/articles';

const featured = await getArticles((a) => a.data.featured);
const popular = (featured.length ? featured : await getArticles()).slice(0, 5);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: new URL('/', Astro.site).toString(),
    description: site.description,
  },
];
---
<BaseLayout jsonLd={jsonLd}>
  <section class="border-b border-line bg-surface">
    <div class="container-page flex flex-wrap items-center gap-12 pt-16 pb-14 sm:pt-[72px]">
      <div class="min-w-0 flex-[999_1_520px]">
        <p class="eyebrow m-0 mb-3 text-accent">For freelancers and the self-employed</p>
        <h1 class="m-0 mb-5 text-[38px] leading-[1.12] font-bold tracking-[-0.025em] sm:text-5xl">{site.tagline}</h1>
        <p class="m-0 mb-8 max-w-[600px] text-xl leading-normal text-muted">
          Health insurance, taxes, registration and banking: clear answers, honest comparisons and calculators, checked
          against official sources.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/start" class="btn-primary">Start here</a>
          <a href="/calculators" class="btn-secondary">Try the calculators</a>
        </div>
      </div>
      <div class="min-w-0 flex-[1_1_340px] rounded-card border border-accent-line bg-accent-soft p-6">
        <p class="m-0 mb-4 text-[15px] font-semibold">Just arrived? Your first steps</p>
        <ol class="m-0 flex list-decimal flex-col gap-2.5 pl-5 text-[15px] text-ink-2">
          <li>Register your address (<span lang="de" class="italic">Anmeldung</span>)</li>
          <li><a href="/health-insurance/freelancers">Choose health insurance</a></li>
          <li>
            <a href="/start/freiberufler-vs-gewerbe">Find out if you're a <span lang="de" class="italic">Freiberufler</span> or <span lang="de" class="italic">Gewerbe</span></a>
          </li>
          {/* LINK: once /start/tax-registration-questionnaire is published, link this step to it */}
          <li>Register with the tax office</li>
          <li>Open a business bank account</li>
          <li>Set up invoicing and bookkeeping</li>
        </ol>
        <a href="/start/become-a-freelancer" class="mt-4 inline-block text-[15px] font-semibold">See the full checklist</a>
      </div>
    </div>
  </section>

  <section class="container-page pt-16 pb-6">
    <h2 class="m-0 mb-2 text-[30px] leading-tight font-bold tracking-[-0.02em]">Pick your topic</h2>
    <p class="m-0 mb-7 text-muted">Each guide starts with a short answer, then goes as deep as you need.</p>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4">
      {hubs.map((hub) => <TopicCard hub={hub} />)}
    </div>
  </section>

  <section id="tools" class="container-page pt-14 pb-6">
    <h2 class="m-0 mb-2 text-[30px] leading-tight font-bold tracking-[-0.02em]">Calculators</h2>
    <p class="m-0 mb-7 text-muted">Your numbers stay in your browser. Nothing is sent or stored.</p>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4">
      {
        calculators.map((c) => (
          <div class="card flex flex-col gap-3 p-6">
            <span class="pill self-start bg-accent-tint text-accent-ink">{c.topic}</span>
            <h3 class="m-0 text-[19px] leading-snug font-semibold">{c.title}</h3>
            <p class="m-0 text-[15px] text-muted">{c.description}</p>
            {c.href ? (
              <a href={c.href} class="mt-auto text-[15px] font-semibold">
                Open calculator
              </a>
            ) : (
              <span class="mt-auto text-[15px] text-muted">Coming soon</span>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page flex flex-wrap gap-10 pt-14 pb-6">
    <div class="min-w-0 flex-[999_1_520px]">
      <h2 class="m-0 mb-5 text-[30px] leading-tight font-bold tracking-[-0.02em]">Popular guides</h2>
      <GuideList articles={popular} />
    </div>
    <div class="card min-w-0 flex-[1_1_320px] self-start p-6">
      <span class="pill bg-chip text-ink-2">Letter decoder</span>
      <h3 class="m-0 mt-3.5 mb-2 text-[19px] leading-snug font-semibold">Got a letter from the tax office?</h3>
      <p class="m-0 mb-4 text-[15px] text-muted">
        Real (anonymized) letters, explained line by line: what it means, what to do, and by when.
      </p>
      <div class="flex flex-col gap-2 rounded-lg border border-dashed border-line-strong bg-page p-3.5 text-[13px] text-ink-2">
        <div class="flex items-baseline gap-2.5">
          <span class="flex size-[22px] shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-on-accent">1</span>
          <span><span lang="de">Steuernummer</span>: your tax number. Put it on every invoice.</span>
        </div>
        <div class="flex items-baseline gap-2.5">
          <span class="flex size-[22px] shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-on-accent">2</span>
          <span><span lang="de">Vorauszahlung</span>: a prepayment, due on the date shown.</span>
        </div>
      </div>
      <span class="mt-4 inline-block text-[15px] text-muted">Coming soon</span>
    </div>
  </section>

  <NewsletterSignup />
</BaseLayout>
